@* Parce que cette vue partielle reçoit uniquement un nombre : l'Id du zombie. *@

@model int 
<div class="col mb-2 mt-2">
    @if (Model == 0) @* sera vraie, donc le bouton Create sera affiché. *@
    {
        <input type="submit" class="btn btn-success w-100" value="Create" />
    }
    else
    {
        <input type="submit" class="btn btn-info w-100" value="Edit" />
    }
</div>
<div class="col mb-2">
    <a asp-action="Index" class="btn btn-secondary w-100">Back to list</a>
</div>
