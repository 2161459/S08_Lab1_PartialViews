@model ZombieParty.Models.HuntingLog

@{
    ViewData["Title"] = Model.Id == 0 ? "Create" : "Edit";
}

<h1>@ViewData["Title"] Hunting Log</h1>

<hr />

<div class="row">
    <div class="col-md-4 bg-white shadow p-3">

        <form asp-action="Upsert" method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title"
                       class="control-label"></label>

                <input asp-for="Title"
                       class="form-control" />

                <span asp-validation-for="Title"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"
                       class="control-label"></label>
                @* Ton professeur demande que Description soit un champ multiligne
                Cela permet d'écrire plusieurs lignes plutôt qu'une seule.
                textarea *@
                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="row mt-3">
                <partial name="_UpsertButtons" model="Model.Id" />
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}